NODE_ENV=development
PORT=4000
# Supabase: Project Settings > API. The service-role key stays on the server ONLY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=8h
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,https://cybersparkit.site,https://www.cybersparkit.site
# Optional email (notifications are skipped, and logged, when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CyberSpark IT Solutions <cybersparkit@gmail.com>"
NOTIFY_EMAIL=cybersparkit@gmail.com
# Optional automation (n8n etc.). Leave empty to disable.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Inbound: lets an automation add AI suggestions as INTERNAL notes. Needs 32+ random characters; empty disables it.
AUTOMATION_API_KEY=
# Data retention for scripts/purge-old-data.js
RETENTION_MONTHS=24
